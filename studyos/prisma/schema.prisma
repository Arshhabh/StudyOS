// Apply the SQL migrations to install Supabase policies, Auth foreign keys and RPCs.
model AssistantUsage {
  userId String @id @map("user_id") @db.Uuid
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  requests Int
  @@map("assistant_usage")
}

generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

model UserProfile {
  id        String   @id @db.Uuid
  userId    String   @default(dbgenerated("auth.uid()")) @map("user_id") @db.Uuid
  payload   Json     @db.JsonB
  syncSeq   BigInt   @default(dbgenerated("nextval('study_change_sequence'::regclass)")) @map("sync_seq")
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

